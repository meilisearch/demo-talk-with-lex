MEILI_MASTER_KEY=talk-with-lex-master-key-change-me
MEILI_HOST=http://localhost:7710

# Embeddings for semantic search. huggingFace runs BAAI/bge-small-en-v1.5 inside Meilisearch
# (free, but ~100k chunks take a while on CPU). openAi uses text-embedding-3-small (fast, ~$0.30 total).
EMBEDDER_SOURCE=huggingFace
EMBEDDER_API_KEY=

# LLM used by Meilisearch chat (/chats). source: openAi | mistral | gemini | azureOpenAi | vLlm
CHAT_SOURCE=openAi
CHAT_API_KEY=
CHAT_BASE_URL=
CHAT_MODEL=gpt-4o-mini
